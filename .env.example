# Gmail is accessed through the configured Codex Gmail plugin/app (`@gmail`).
# No project-local Gmail OAuth credentials are required.

# Xero API Configuration (Desktop app with PKCE - no secret needed)
# Create a "Mobile or desktop app" at https://developer.xero.com/app/manage
XERO_CLIENT_ID=your_client_id_here
XERO_REDIRECT_URI=http://localhost:3000/callback

# Business identity used by reimbursement workflows.
# Keep these values in your local .env or a mounted 1Password Environment.
EXPENSE_OWNER_NAME=Your Name
EXPENSE_OWNER_EMAIL=you@example.com
XERO_EXPENSE_USER_ID=your-xero-user-id
XERO_REIMBURSEMENT_VENDOR=Your Business Name

# Amazon Account Credentials
# Your Amazon.com login email and password for order history
# For 2FA: You'll be prompted for OTP code when logging in
AMAZON_USERNAME=your-amazon-email@example.com
AMAZON_PASSWORD=your-amazon-password
